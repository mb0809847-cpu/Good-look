  }
  .pill svg { width: 1rem; height: 1rem; color: #f97316; }
  .pill .dot { color: #d1d5db; }
  h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #1a1a2e;
  }
  @media (min-width: 640px) { h1 { font-size: 3.75rem; } }
  .subtitle {
    margin-top: 1.5rem;
    max-width: 20rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #666677;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    padding: 0.75rem 2rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.15s, background 0.15s;
  }
  .btn svg { width: 1rem; height: 1rem; }
  .btn-primary {
    margin-top: 1.5rem;
    background: #f97316;
    color: #ffffff;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
  }
  .btn-primary:hover { opacity: 0.9; }
  .btn-secondary {
    margin-top: 0.75rem;
    background: #ffffff;
    color: #1a1a2e;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.07);
  }
  .btn-secondary:hover { background: #f5f5f7; }
</style>
</head>
