<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bem-vindo ao meu site! 🚀</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: #f5f5f7;
        color: #1d1d1f;
        min-height: 100vh;
      }
      nav {
        background: #fff;
        border-bottom: 1px solid #e2e2e5;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        gap: 24px;
      }
      nav .logo { font-size: 18px; font-weight: 700; text-decoration: none; color: #1d1d1f; }
      nav a.nav-link { font-size: 15px; text-decoration: none; color: #6e6e73; font-weight: 500; }
      nav a.nav-link:hover { color: #1d1d1f; }
      nav a.nav-link.active { color: #0071e3; }
      .hero { text-align: center; padding: 80px 24px; }
      .hero h1 { font-size: 32px; font-weight: 700; margin-bottom: 12px; }
      .hero a { display: inline-block; margin-top: 20px; padding: 12px 28px; background: #0071e3; color: #fff; text-decoration: none; border-radius: 10px; font-size: 15px; font-weight: 600; }
      .hero a:hover { background: #0058b3; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/" class="logo">🚀 Meu Site</a>
      <a href="/" class="nav-link active">Início</a>
      <a href="/activity.html" class="nav-link">Atividades</a>
    </nav>
    <div class="hero">
      <h1>Bem-vindo ao meu site! 🚀</h1>
      <a href="/activity.html">Ver atividades recentes</a>
    </div>
  </body>
</html>
